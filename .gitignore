# Allow-list: everything is ignored unless listed below. The game's files, the generated C++ (recompiled from the
# game's code), translated shaders, build output, NSPs and keys never belong in this repository.
/*
!/.gitignore
!/.gitattributes
!/.gitmodules
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md

!/docs/
/docs/*
!/docs/building.md
!/patches/

!/nsp/
/nsp/*
!/nsp/build_nsp.ps1
!/nsp/make_control.py
!/nsp/loader/
/nsp/loader/build/
/nsp/loader/*.nso
/nsp/loader/*.npdm
/nsp/loader/*.nacp
/nsp/loader/*.elf
/nsp/loader/*.map

!/port/
/port/*
!/port/CMakeLists.txt
!/port/CMakePresets.json
!/port/shank1_manifest.toml
!/port/overrides.toml
!/port/cmake/
!/port/src/
!/port/assets/
!/port/tools/
/port/tools/__pycache__/
/port/tools/usm/

!/tools/
/tools/*
!/tools/vsenv.ps1
!/tools/setup.ps1
!/tools/sa2-nx

*.nsp
*.nro
*.xex
*.nxpack
*.nxidx
*.keys
*.log
*.bak
__pycache__/
/port/tools/boot_loop.ps1
/port/tools/run_renut_test.ps1
/port/tools/press.ps1
/port/tools/grab.ps1
/port/tools/audio_gaps.py
